APP_NAME="PURO Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=purocare
DB_USERNAME=puro
DB_PASSWORD=change_this_local_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Aktifkan hanya untuk demo lokal. Akun & QRIS demo tidak dibuat di production.
PURO_DEMO_MODE=false
PURO_ADMIN_WHATSAPP=

# Kunci hanya di server, jangan gunakan VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_MIN_SIMILARITY=0.56
RAG_TOP_K=5
